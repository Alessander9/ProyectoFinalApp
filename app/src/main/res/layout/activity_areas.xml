<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutAreas"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AreasActivity">

    <!-- Barra de búsqueda -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilBuscarArea"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etBuscarArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Buscar área..."
            android:inputType="text"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Lista de áreas -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewAreas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/tilBuscarArea"
        app:layout_constraintBottom_toTopOf="@id/fabCrearArea"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_area"/>

    <!-- Botón para crear nueva área -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCrearArea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Nueva área"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/morado"
        app:tint="@color/blanco"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
