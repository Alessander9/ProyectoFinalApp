<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Nombre del área -->
    <TextView
        android:id="@+id/tvNombreDetalleArea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Nombre del Área"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Botón Editar -->
    <Button
        android:id="@+id/btnEditarArea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Editar"
        app:layout_constraintTop_toBottomOf="@id/tvNombreDetalleArea"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnEliminarArea"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="8dp" />

    <!-- Botón Eliminar -->
    <Button
        android:id="@+id/btnEliminarArea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Eliminar"
        app:layout_constraintTop_toBottomOf="@id/tvNombreDetalleArea"
        app:layout_constraintStart_toEndOf="@id/btnEditarArea"
        app:layout_constraintEnd_toStartOf="@id/btnCancelarArea"
        android:layout_marginTop="24dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:textColor="@color/design_default_color_error" />

    <!-- Botón Cancelar -->
    <Button
        android:id="@+id/btnCancelarArea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Cancelar"
        app:layout_constraintTop_toBottomOf="@id/tvNombreDetalleArea"
        app:layout_constraintStart_toEndOf="@id/btnEliminarArea"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginStart="8dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
